{
  "name": "@agentlane/process-bridge",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "TypeScript helpers for AgentLane local process bridge apps.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "format": "biome format --write src tests",
    "lint": "biome check --error-on-warnings src tests",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "@types/bun": "^1.3.4",
    "typescript": "^5.9.3"
  }
}
